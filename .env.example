# Copy to .env.local (git-ignored) and fill in what you have. Everything is optional:
# with no keys the app still works (Polish imagery + Polish address search + demo mode).
#
# IMPORTANT: every EXPO_PUBLIC_* value is compiled into the app bundle and is
# therefore PUBLIC. Only use keys that are meant for client apps and restricted
# by the provider (allowed apps / referrers / quotas). Never put server secrets here.

# Global address search (Geoapify free plan: 3,000 credits/day, attribution required).
# Restrict the key in the Geoapify dashboard.
EXPO_PUBLIC_GEOAPIFY_API_KEY=

# Esri World Imagery outside Poland. OFF by default: the licence for tracing user
# boundaries over World Imagery in a non-ArcGIS app is not confirmed (see
# docs/provider-research.md). Enable only after Esri confirms in writing.
EXPO_PUBLIC_ARCGIS_API_KEY=
EXPO_PUBLIC_ENABLE_ESRI_IMAGERY=false

# Optional extra XYZ imagery source you are licensed to use (e.g. a national open orthophoto).
# Template must contain {z}/{x}/{y}.
EXPO_PUBLIC_CUSTOM_IMAGERY_URL=
EXPO_PUBLIC_CUSTOM_IMAGERY_NAME=
EXPO_PUBLIC_CUSTOM_IMAGERY_ATTRIBUTION=
EXPO_PUBLIC_CUSTOM_IMAGERY_MAXZOOM=19

# Surrounding buildings from OpenStreetMap. The public Overpass instance is for
# development only — point this at your own instance for production.
EXPO_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter
EXPO_PUBLIC_ENABLE_OSM_CONTEXT=true
